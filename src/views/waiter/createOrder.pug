extends ../layout

block content
  .page-wide
    .page-title Create New Order — Table #{table.tableNumber}

    form#order-form(action=`/waiter/table/${table.id}/order` method="POST")
      .order-layout
        .menu-section
          each items, category in grouped
            .category-block
              .category-name= category
              each item in items
                .menu-item-row
                  .menu-item-info
                    .menu-item-name= item.name
                    if item.description
                      .menu-item-desc= item.description
                    .menu-item-price €#{item.price}
                  .menu-item-controls
                    .qty-row
                      button.qty-btn(type="button" data-action="decrease" data-id=item.id) −
                      input.qty-input(
                        type="number"
                        name=`qty_${item.id}`
                        value="0"
                        min="0"
                        max="20"
                        id=`qty-${item.id}`
                        data-price=item.price
                        readonly
                      )
                      button.qty-btn(type="button" data-action="increase" data-id=item.id) +
                    input.notes-field(
                      type="text"
                      name=`notes_${item.id}`
                      placeholder="Notes..."
                      id=`notes-${item.id}`
                    )

        .order-summary
          .summary-title Order Summary
          #summary-list
            p.summary-empty No items added yet.
          .order-total-row#summary-total(style="display:none")
            span Total
            span#summary-total-value
          button.btn.btn-dark.btn-full(type="submit") Submit Order

  script(src="/js/waiter.js")
