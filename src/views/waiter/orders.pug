extends ../layout

block content
  .page-header
    h2 My Orders
    a.btn.btn-secondary(href="/waiter") Back to Tables

  if orders.length === 0
    .empty-state
      p No orders yet. Select a table to start an order.
  else
    .orders-list
      each order in orders
        .order-card
          .order-card-header
            .order-meta
              span.order-id Order ##{order.id}
              span.order-table Table #{order.table ? order.table.tableNumber : 'N/A'}
              span.order-time= new Date(order.createdAt).toLocaleTimeString('en-GB', {hour: '2-digit', minute: '2-digit'})
            span.status-badge(class=`status-${order.status.toLowerCase()}`)= order.status.replace('_', ' ')
          .order-items-list
            each item in order.orderItems
              .order-item-row
                .item-detail
                  span.item-qty= item.quantity + 'x'
                  span.item-name= item.menuItem.name
                  if item.notes
                    span.item-notes  (#{item.notes})
                .item-status-section
                  span.status-badge(class=`status-${item.status.toLowerCase()}`)= item.status
                  if item.status === 'READY'
                    form(action=`/waiter/orders/item/${item.id}/deliver` method="POST" style="display:inline")
                      button.btn.btn-sm.btn-success(type="submit") Mark Delivered
