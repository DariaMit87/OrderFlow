extends ../layout

block content
  .page
    .page-title Order Status

    if orders.length === 0
      .empty-state No orders yet. Select a table to start an order.
    else
      .orders-stack
        each order in orders
          - const total = order.orderItems.reduce((sum, i) => sum + (parseFloat(i.menuItem.price) * i.quantity), 0)
          .order-card
            .order-card-header
              .order-header-left
                .order-table-name Table #{order.table ? order.table.tableNumber : 'N/A'}
                .order-meta Order ##{order.id} &bull; #{new Date(order.createdAt).toLocaleTimeString('en-GB', {hour: '2-digit', minute: '2-digit'})}
              span.badge(class=order.status === 'IN_PROGRESS' ? 'badge-progress' : order.status === 'COMPLETED' ? 'badge-completed' : 'badge-new')
                = order.status === 'IN_PROGRESS' ? 'In Progress' : order.status === 'COMPLETED' ? 'Completed' : order.status
            .order-items-body
              each item in order.orderItems
                .order-item-row
                  .item-name-qty
                    span.item-qty= item.quantity + 'x'
                    span.item-name= item.menuItem.name
                    if item.notes
                      span.item-note  (#{item.notes})
                  .item-right
                    span.badge(class=`badge-${item.status.toLowerCase()}`)= item.status.toLowerCase()
                    span.item-price €#{(parseFloat(item.menuItem.price) * item.quantity).toFixed(2)}
                    if item.status === 'READY'
                      form(action=`/waiter/orders/item/${item.id}/deliver` method="POST")
                        button.btn.btn-sm.btn-dark(type="submit") Mark Delivered
            .order-total-row
              span Total
              span €#{total.toFixed(2)}
