extends ../layout

block content
  .page-wide
    .page-title Tables
    .tables-grid
      each table in tables
        .table-card(class=table.isOccupied ? 'occupied' : '')
          .table-num Table #{table.tableNumber}
          .table-seats #{table.seats} seats
          span.table-status-label(class=table.isOccupied ? 'status-occupied' : 'status-free')
            = table.isOccupied ? 'Occupied' : 'Free'
          br
          a.btn.btn-sm(
            href=`/waiter/table/${table.id}/order`
            class=table.isOccupied ? 'btn-gray' : 'btn-dark'
          )= table.isOccupied ? 'Add Order' : 'Take Order'
