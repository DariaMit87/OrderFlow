doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title OrderFlow — Login
    link(rel="stylesheet" href="/css/styles.css")
  body
    .login-page
      .login-card
        if error && error.length
          each msg in error
            .alert.alert-error= msg
        h1.login-title OrderFlow Login
        form(action="/login" method="POST")
          .form-group
            label(for="username") Username
            input#username(type="text" name="username" placeholder="Enter your username" required autofocus)
          .form-group
            label(for="password") Password
            input#password(type="password" name="password" placeholder="Enter your password" required)
          button.btn.btn-dark.btn-full(type="submit") Login
