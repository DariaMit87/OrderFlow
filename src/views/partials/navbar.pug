nav.navbar
  a.navbar-brand(href="/dashboard") OrderFlow
  .navbar-nav
    if user.role === 'WAITER'
      a.nav-link(href="/waiter") Point of Sale
      a.nav-link(href="/waiter/orders") Orders
    else if user.role === 'COOK'
      a.nav-link(href="/kitchen") Kitchen Display
  .navbar-right
    span.nav-username= user.name
    form(action="/logout" method="POST" style="display:inline")
      button.nav-icon-btn(type="submit" title="Logout") &#x2192;
